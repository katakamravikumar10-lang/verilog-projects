module tb;

  reg [3:0] d;
  wire [1:0] y;
  wire v;

  priority_encoder dut(
    .d(d),
    .y(y),
    .v(v)
  );

  initial begin
    $dumpfile("priority_encoder.vcd");
    $dumpvars(0, tb);

    $monitor("time=%0t, d=%b, y=%b, v=%b",
             $time, d, y, v);
  end

  initial begin

    d = 4'b0000;
    #10;

    d = 4'b0001;
    #10;

    d = 4'b0010;
    #10;

    d = 4'b0011;
    #10;

    d = 4'b0111;
    #10;

    d = 4'b1100;
    #10;

    d = 4'b1111;
    #10;

    $finish;

  end

endmodule