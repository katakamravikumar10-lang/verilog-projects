module tb;
  reg [3:0]a;
  reg [3:0]b;
  wire gt;
  wire eq;
  wire lt;
  
  comparator_4bit dut(
    
    .a(a),
    .b(b),
    .gt(gt),
    .eq(eq),
    .lt(lt)
  );
  
  initial begin
    $dumpfile("comparator_4bit.vcd");
    $dumpvars(0,tb);
    $monitor("time=%0t, a=%b, b=%b, gt=%b, eq=%b, lt=%b",
             $time, a,b,gt,eq,lt);
  end
  
  initial begin
    
    a = 4'b1010;
    b = 4'b0011;
    #10;
    
    a = 4'b0101;
    b = 4'b1100;
    #10;
    
    a= 4'b1101;
    b = 4'b0010;
    #10;
    
    $finish;
  end
endmodule