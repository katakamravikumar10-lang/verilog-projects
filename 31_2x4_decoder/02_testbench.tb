module tb;
  
  reg a;
  reg b;
  wire [3:0] y;
  
  decoder_2x4 dut(
    .a(a),
    .b(b),
    .y(y)
  );
  initial begin
    $dumpfile("decoder_2x4.vcd");
    $dumpvars(0,tb);
    $monitor("time=%0t, a=%b, b=%b, y=%b",
             $time, a, b, y);
  end
  initial begin
    a=0;
    b=0;
    #10;
    
    a=0;
    b=1;
    #10;
    
    a=1;
    b=0;
    #10;
    
    a=1;
    b=1;
    #10;
    $finish;
  end
endmodule