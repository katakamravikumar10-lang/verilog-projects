module tb;

  reg [3:0] d;
  wire [1:0] y;

  encoder_4x2 dut(
    .d(d),
    .y(y)
  );

  initial begin
    $dumpfile("encoder_4x2.vcd");
    $dumpvars(0,tb);

    $monitor("time=%0t, d=%b, y=%b",
             $time, d, y);
  end

  initial begin

    d = 4'b0001;   // D0 → 00
    #10;

    d = 4'b0010;   // D1 → 01
    #10;

    d = 4'b0100;   // D2 → 10
    #10;

    d = 4'b1000;   // D3 → 11
    #10;

    $finish;

  end

endmodule