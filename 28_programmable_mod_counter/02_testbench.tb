module tb;
  reg clk;
  reg reset;
  reg [3:0] mod_n;
  wire [3:0] q;
  programmable_mod_counter dut(
    .clk(clk),
    .reset(reset),
    .mod_n(mod_n),
    .q(q)
  );
  always #10 clk = ~clk;
  initial begin
    $dumpfile("programmable_mod_counter.vcd");
    $dumpvars(0,tb);
    $monitor("time=%0t, clk=%b, reset=%b, mod_n=%b, q=%b",
              $time, clk, reset, mod_n, q);
  end
  initial begin
    reset = 1;
    clk = 0;
    #10;
    
    mod_n = 4'b0101;
    reset = 0;
    #90;
    $finish;
  end
endmodule